// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id
  accountNumberBase Int      @unique @default(autoincrement())
  balance           Decimal  @default(0.0)
  createdAt         DateTime @default(now())

  transfersSent     Transfer[] @relation("AccountTransfersSent")
  transfersReceived Transfer[] @relation("AccountTransfersReceived")
}

model Transfer {
  id            String   @id
  transactionId String   @unique
  from          Account  @relation("AccountTransfersSent", fields: [fromAccountId], references: [id])
  fromAccountId String
  to            Account  @relation("AccountTransfersReceived", fields: [toAccountId], references: [id])
  toAccountId   String
  amount        Decimal
  createdAt     DateTime @default(now())
}
